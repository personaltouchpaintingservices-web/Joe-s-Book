# Copy this file to .env.local for local dev, and add the same
# values in Vercel under Project Settings -> Environment Variables.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" public key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The exact name of your storage bucket
NEXT_PUBLIC_SUPABASE_BUCKET=

# Optional: a link to your Ko-fi / PayPal.me / Venmo / Cash App page.
# If left blank, the Donate button/link just won't show up anywhere.
NEXT_PUBLIC_DONATE_URL=
